@model MasrAcademyTech.DAL.Models.Courses.Course
@{
    ViewData["Title"] = "حذف كورس";
}

<div class="max-w-lg mx-auto px-4 py-16 text-center animate-fade-in">
    <i class="fas fa-exclamation-triangle text-red-500 text-5xl mb-4"></i>
    <h2 class="text-2xl font-bold text-gray-800 mb-2">هل أنت متأكد من حذف هذا الكورس؟</h2>
    <p class="text-lg font-medium text-gray-700 mb-1">@Model.Title</p>
    <p class="text-gray-500 mb-8">@Model.Description</p>

    <form asp-action="Delete" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="bg-red-600 text-white px-6 py-3 rounded-lg hover:bg-red-700 transition-all font-medium ml-2">
            <i class="fas fa-trash ml-1"></i> حذف
        </button>
        <a asp-action="Index" class="bg-gray-200 text-gray-700 px-6 py-3 rounded-lg hover:bg-gray-300 transition-all font-medium">إلغاء</a>
    </form>
</div>