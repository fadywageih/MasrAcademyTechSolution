@model MasrAcademyTech.DAL.Models.Courses.Lesson
@{
    ViewData["Title"] = "إضافة حلقة";
}

<div class="max-w-2xl mx-auto px-4 py-8 animate-fade-in">
    <h2 class="text-2xl font-bold text-gray-800 mb-6">
        <i class="fas fa-plus-circle text-green-600 ml-2"></i>إضافة حلقة جديدة
    </h2>

    <form asp-action="AddLesson" enctype="multipart/form-data" method="post" class="bg-white rounded-xl shadow p-6 space-y-5">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="CourseId" />

        <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">العنوان</label>
            <input asp-for="Title" class="w-full border border-gray-300 rounded-lg p-3 focus:ring-2 focus:ring-blue-500 outline-none" />
        </div>

        <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">الترتيب</label>
            <input asp-for="Order" class="w-full border border-gray-300 rounded-lg p-3 focus:ring-2 focus:ring-blue-500 outline-none" />
        </div>

        <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">الفيديو</label>
            <input type="file" name="video" class="w-full border border-gray-300 rounded-lg p-3" />
        </div>

        <button type="submit" class="bg-green-600 text-white px-6 py-3 rounded-lg hover:bg-green-700 transition-all font-medium">
            <i class="fas fa-save ml-1"></i> حفظ
        </button>
        <a asp-action="Lessons" asp-route-id="@Model.CourseId" class="text-gray-500 hover:text-gray-700 mr-4">إلغاء</a>
    </form>
</div>