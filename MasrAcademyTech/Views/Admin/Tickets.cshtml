@model IEnumerable<MasrAcademyTech.DAL.Models.Courses.SupportTicket>
@{
    ViewData["Title"] = "تذاكر الدعم";
}

<div class="max-w-7xl mx-auto px-4 py-8 animate-fade-in">
    <h2 class="text-2xl font-bold text-gray-800 mb-6">
        <i class="fas fa-ticket-alt text-blue-600 ml-2"></i>تذاكر الدعم
    </h2>

    @if (!Model.Any())
    {
        <div class="text-center py-16 bg-white rounded-xl shadow">
            <i class="fas fa-inbox text-gray-300 text-5xl mb-4"></i>
            <p class="text-gray-500">لا يوجد تذاكر حالياً</p>
        </div>
    }
    else
    {
        <div class="bg-white rounded-xl shadow overflow-hidden">
            <table class="w-full">
                <thead class="bg-gray-50 border-b">
                    <tr>
                        <th class="p-4 text-right text-sm font-medium text-gray-600">المستخدم</th>
                        <th class="p-4 text-right text-sm font-medium text-gray-600">الموضوع</th>
                        <th class="p-4 text-right text-sm font-medium text-gray-600">الرسالة</th>
                        <th class="p-4 text-right text-sm font-medium text-gray-600">التاريخ</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ticket in Model)
                    {
                        <tr class="border-b hover:bg-gray-50 transition">
                            <td class="p-4">@ticket.UserId</td>
                            <td class="p-4 font-medium">@ticket.Subject</td>
                            <td class="p-4 text-gray-500">@ticket.Message</td>
                            <td class="p-4 text-gray-400 text-sm">@ticket.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>