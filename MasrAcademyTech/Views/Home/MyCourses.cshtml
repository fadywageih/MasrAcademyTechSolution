@model IEnumerable<MasrAcademyTech.DAL.Models.Courses.Course>
@{
    ViewData["Title"] = "كورساتي";
}

<div class="bg-gray-50 min-h-screen">
    <!-- Header -->
    <section class="bg-gradient-to-r from-blue-600 to-indigo-700 text-white py-12">
        <div class="max-w-7xl mx-auto px-4">
            <h1 class="text-3xl font-extrabold animate-fade-in">
                <i class="fas fa-play-circle ml-2"></i>كورساتي
            </h1>
            <p class="text-blue-100 mt-2">الكورسات التي قمت بشرائها</p>
        </div>
    </section>

    <div class="max-w-7xl mx-auto px-4 py-12">
        @if (!Model.Any())
        {
            <div class="text-center py-24 animate-fade-in">
                <div class="w-24 h-24 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-6">
                    <i class="fas fa-book-open text-gray-300 text-5xl"></i>
                </div>
                <h3 class="text-xl font-bold text-gray-600 mb-2">لا يوجد كورسات بعد</h3>
                <p class="text-gray-400 mb-6">ابدأ رحلتك التعليمية الآن</p>
                <a asp-action="Courses" class="inline-flex items-center gap-2 bg-blue-600 text-white px-8 py-3.5 rounded-xl font-bold hover:bg-blue-700 transition shadow-lg">
                    <i class="fas fa-search"></i> تصفح الكورسات
                </a>
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                @foreach (var course in Model)
                {
                    <div class="group bg-white rounded-2xl shadow-sm hover:shadow-2xl transition-all duration-500 overflow-hidden hover-lift animate-fade-in">
                        @if (!string.IsNullOrEmpty(course.ImagePath))
                        {
                            <img src="@course.ImagePath" class="w-full h-52 object-cover group-hover:scale-105 transition-transform duration-500" />
                        }
                        else
                        {
                            <div class="w-full h-52 bg-gradient-to-br from-blue-50 to-indigo-100 flex items-center justify-center">
                                <i class="fas fa-graduation-cap text-blue-300 text-5xl"></i>
                            </div>
                        }
                        <div class="p-6">
                            <h3 class="text-xl font-bold text-gray-800 mb-2 group-hover:text-blue-600 transition">@course.Title</h3>
                            <p class="text-gray-500 text-sm mb-5">@course.Description</p>
                            <a asp-action="Watch" asp-route-id="@course.Id"
                               class="block text-center bg-gradient-to-r from-blue-600 to-blue-700 text-white py-3 rounded-xl font-bold hover:from-blue-700 hover:to-blue-800 transition-all shadow-md hover:shadow-lg">
                                <i class="fas fa-play ml-2"></i> مشاهدة الحلقات
                            </a>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>