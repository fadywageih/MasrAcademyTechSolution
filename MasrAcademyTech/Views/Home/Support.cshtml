@model MasrAcademyTech.DAL.Models.Courses.SupportTicket
@{
    ViewData["Title"] = "الدعم الفني";
}

<div class="max-w-3xl mx-auto px-4 py-12 animate-fade-in">
    <h2 class="text-3xl font-bold text-gray-800 text-center mb-8">
        <i class="fas fa-headset text-blue-600 ml-2"></i>الدعم الفني
    </h2>

    <div class="grid md:grid-cols-2 gap-8">
        <!-- WhatsApp -->
        <div class="bg-white rounded-2xl shadow p-6 text-center">
            <i class="fab fa-whatsapp text-green-500 text-5xl mb-4"></i>
            <h3 class="text-xl font-bold text-gray-800 mb-2">واتساب</h3>
            <p class="text-gray-500 mb-4">تواصل معنا مباشرة عبر الواتساب</p>
            <a href="https://wa.me/201000000000" target="_blank" class="inline-block bg-green-500 text-white px-6 py-3 rounded-xl font-bold hover:bg-green-600 transition">
                <i class="fab fa-whatsapp ml-2"></i> فتح المحادثة
            </a>
        </div>

        <!-- Ticket Form -->
        <div class="bg-white rounded-2xl shadow p-6">
            <h3 class="text-xl font-bold text-gray-800 mb-4 text-center">تذكرة دعم</h3>

            @if (TempData["Success"] != null)
            {
                <div class="bg-green-50 text-green-700 p-3 rounded-lg mb-4 text-center">@TempData["Success"]</div>
            }

            <form asp-action="Support" method="post" class="space-y-4">
                @Html.AntiForgeryToken()

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">الموضوع</label>
                    <input asp-for="Subject" class="w-full border border-gray-300 rounded-lg p-3 focus:ring-2 focus:ring-blue-500 outline-none" />
                    <span asp-validation-for="Subject" class="text-red-500 text-xs"></span>
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">الرسالة</label>
                    <textarea asp-for="Message" rows="4" class="w-full border border-gray-300 rounded-lg p-3 focus:ring-2 focus:ring-blue-500 outline-none"></textarea>
                    <span asp-validation-for="Message" class="text-red-500 text-xs"></span>
                </div>

                <button type="submit" class="w-full bg-blue-600 text-white py-3 rounded-xl font-bold hover:bg-blue-700 transition">
                    <i class="fas fa-paper-plane ml-2"></i> إرسال
                </button>
            </form>
        </div>
    </div>
</div>