@model MasrAcademyTech.DAL.Models.Courses.Course
@{
    ViewData["Title"] = Model.Title;
    var lessons = ViewBag.Lessons as IEnumerable<MasrAcademyTech.DAL.Models.Courses.Lesson>;
}

<div class="bg-gray-50 min-h-screen">
    <section class="bg-gradient-to-r from-blue-600 to-indigo-700 text-white py-8">
        <div class="max-w-7xl mx-auto px-4">
            <a asp-action="MyCourses" class="text-blue-200 hover:text-white transition text-sm mb-3 inline-block">
                <i class="fas fa-arrow-right ml-2"></i> العودة لكورساتي
            </a>
            <h1 class="text-2xl md:text-3xl font-extrabold animate-fade-in">@Model.Title</h1>
        </div>
    </section>

    <div class="max-w-7xl mx-auto px-4 py-8">
        <div class="grid lg:grid-cols-3 gap-6">
            <div class="lg:col-span-2">
                <div class="bg-black rounded-2xl overflow-hidden shadow-2xl animate-fade-in relative">
                    <video id="player" controls controlsList="nodownload" oncontextmenu="return false;"
                           class="w-full aspect-video" poster="@Model.ImagePath">
                        <source src="" type="video/mp4">
                        المتصفح لا يدعم تشغيل الفيديو
                    </video>
                </div>
                <div class="mt-4 bg-white rounded-xl p-4 shadow-sm">
                    <p id="currentLessonTitle" class="text-gray-500 text-center">اختر حلقة من القائمة للمشاهدة</p>
                </div>
            </div>
            <div class="bg-white rounded-2xl shadow-sm p-5 h-fit lg:sticky lg:top-24 animate-slide-in">
                <h3 class="text-lg font-bold text-gray-800 mb-4 flex items-center gap-2">
                    <i class="fas fa-list-ol text-blue-600"></i> الحلقات
                    <span class="text-gray-400 text-sm font-normal">(@lessons!.Count())</span>
                </h3>
                <div class="space-y-2 max-h-[500px] overflow-y-auto">
                    @foreach (var lesson in lessons!)
                    {
                        <button onclick="playLesson(@lesson.Id, '@lesson.Title')"
                                class="lesson-btn w-full text-right p-3.5 rounded-xl hover:bg-blue-50 transition-all flex items-center gap-3 group">
                            <span class="w-9 h-9 bg-gray-100 group-hover:bg-blue-600 group-hover:text-white text-gray-500 rounded-lg flex items-center justify-center font-bold text-sm shrink-0 transition-all">
                                @lesson.Order
                            </span>
                            <span class="font-medium text-gray-700 group-hover:text-blue-600 transition text-sm">@lesson.Title</span>
                            <i class="fas fa-play-circle text-gray-300 group-hover:text-blue-600 transition mr-auto"></i>
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    video::-webkit-media-controls-download-button {
        display: none !important;
    }
    video::-internal-media-controls-download-button {
        display: none !important;
    }
</style>

@section Scripts {
    <script>
        function playLesson(id, title) {
            var player = document.getElementById('player');
            player.src = '/Home/StreamVideo?lessonId=' + id;
            document.getElementById('currentLessonTitle').innerText = title;

            document.querySelectorAll('.lesson-btn').forEach(btn => {
                btn.classList.remove('bg-blue-50');
                btn.querySelector('span:first-child').classList.remove('bg-blue-600', 'text-white');
                btn.querySelector('span:first-child').classList.add('bg-gray-100', 'text-gray-500');
            });
            event.currentTarget.classList.add('bg-blue-50');
            event.currentTarget.querySelector('span:first-child').classList.remove('bg-gray-100', 'text-gray-500');
            event.currentTarget.querySelector('span:first-child').classList.add('bg-blue-600', 'text-white');
        }

        document.getElementById('player').addEventListener('contextmenu', function(e) {
            e.preventDefault();
        });

        document.addEventListener('keydown', function(e) {
            if (e.ctrlKey && (e.key === 's' || e.key === 'S')) {
                e.preventDefault();
            }
        });
    </script>
}