@model IEnumerable<MasrAcademyTech.DAL.Models.Courses.Course>
@{
    ViewData["Title"] = "الكورسات";
}

<div class="bg-gray-50 min-h-screen">
    <!-- Header -->
    <section class="bg-gradient-to-r from-blue-600 to-indigo-700 text-white py-16">
        <div class="max-w-7xl mx-auto px-4 text-center">
            <h1 class="text-4xl font-extrabold mb-4 animate-fade-in">الكورسات المتاحة</h1>
            <p class="text-blue-100 text-lg animate-fade-in">تصفح جميع الكورسات وابدأ التعلم اليوم</p>
        </div>
    </section>

    <div class="max-w-7xl mx-auto px-4 py-12">
        @if (!Model.Where(c => c.IsActive).Any())
        {
            <div class="text-center py-24 bg-white rounded-3xl shadow-sm animate-fade-in">
                <i class="fas fa-book-open text-gray-200 text-8xl mb-6"></i>
                <p class="text-gray-400 text-xl">لا يوجد كورسات متاحة حالياً</p>
                <p class="text-gray-300 mt-2">ترقبوا إضافة كورسات جديدة قريباً</p>
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                @foreach (var course in Model.Where(c => c.IsActive))
                {
                    <div class="group bg-white rounded-2xl shadow-sm hover:shadow-2xl transition-all duration-500 overflow-hidden hover-lift animate-fade-in">
                        <!-- Image -->
                        <div class="relative overflow-hidden">
                            @if (!string.IsNullOrEmpty(course.ImagePath))
                            {
                                <img src="@course.ImagePath" alt="@course.Title" class="w-full h-56 object-cover group-hover:scale-110 transition-transform duration-700" />
                            }
                            else
                            {
                                <div class="w-full h-56 bg-gradient-to-br from-blue-50 to-indigo-100 flex items-center justify-center">
                                    <i class="fas fa-graduation-cap text-blue-300 text-6xl group-hover:scale-125 transition-transform duration-500"></i>
                                </div>
                            }
                            <!-- Price Badge -->
                            <div class="absolute top-4 left-4 bg-white/90 backdrop-blur-sm text-blue-700 px-4 py-2 rounded-xl font-bold text-lg shadow-lg">
                                @course.Price.ToString("C")
                            </div>
                            <!-- Lessons Badge -->
                            <div class="absolute top-4 right-4 bg-black/50 backdrop-blur-sm text-white px-3 py-1.5 rounded-lg text-sm">
                                <i class="fas fa-film ml-1"></i> @course.Lessons.Count
                            </div>
                        </div>

                        <!-- Content -->
                        <div class="p-6">
                            <h3 class="text-xl font-bold text-gray-800 mb-3 group-hover:text-blue-600 transition-colors">
                                @course.Title
                            </h3>
                            <p class="text-gray-500 text-sm mb-5 line-clamp-2 leading-relaxed">@course.Description</p>

                            <!-- Footer -->
                            <div class="flex items-center justify-between pt-4 border-t border-gray-100">
                                <span class="text-gray-400 text-xs flex items-center gap-1">
                                    <i class="fas fa-calendar-alt"></i> @course.CreatedAt.ToString("dd/MM/yyyy")
                                </span>
                                <a asp-action="Details" asp-route-id="@course.Id"
                                   class="inline-flex items-center gap-2 bg-blue-600 text-white px-5 py-2.5 rounded-xl text-sm font-medium hover:bg-blue-700 transition-all shadow-md hover:shadow-lg">
                                    التفاصيل <i class="fas fa-arrow-left text-xs"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>