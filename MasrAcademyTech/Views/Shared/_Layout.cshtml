<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MasrAcademyTech</title>

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Font Awesome للأيقونات -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <style>
        /* Animation بسيطة */
        @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
        }
        .animate-fade-in {
        animation: fadeIn 0.6s ease-out;
        }
        @@keyframes slideIn {
        from { opacity: 0; transform: translateX(-20px); }
        to { opacity: 1; transform: translateX(0); }
        }
        .animate-slide-in {
        animation: slideIn 0.5s ease-out;
        }
    </style>
</head>
<body class="bg-gray-50 min-h-screen flex flex-col">

    <!-- Navbar -->
    <nav class="bg-white shadow-sm border-b border-gray-100">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-16">
                <!-- Logo -->
                <a href="/" class="flex items-center space-x-2 rtl:space-x-reverse">
                    <img src="/images/logo.jpg" alt="MasrAcademyTech" class="h-16 w-auto" />
                </a>

                <!-- Menu -->
                <div class="flex items-center space-x-4 rtl:space-x-reverse">
                    <a href="/" class="text-gray-600 hover:text-blue-600 transition-colors">الرئيسية</a>
                    <a href="#" class="text-gray-600 hover:text-blue-600 transition-colors">الكورسات</a>

                    @if (User.Identity?.IsAuthenticated ?? false)
                    {
                        <span class="text-gray-600">مرحباً، @User.Identity.Name</span>
                        <form asp-action="Logout" asp-controller="Account" method="post" class="inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="text-red-500 hover:text-red-700 transition-colors">
                                <i class="fas fa-sign-out-alt"></i> خروج
                            </button>
                        </form>
                    }
                    else
                    {
                        <a href="/Account/Login" class="text-blue-600 hover:text-blue-800 transition-colors font-medium">دخول</a>
                        <a href="/Account/Register" class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 transition-all text-sm font-medium">تسجيل</a>
                    }
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="flex-grow">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="bg-white border-t border-gray-100 py-6 mt-auto">
        <div class="max-w-7xl mx-auto px-4 text-center text-gray-500 text-sm">
            © @DateTime.Now.Year MasrAcademyTech. جميع الحقوق محفوظة.
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>