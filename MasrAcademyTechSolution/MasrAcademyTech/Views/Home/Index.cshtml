@{
    ViewData["Title"] = "الرئيسية";
}

<!-- Hero -->
<section class="relative bg-gradient-to-br from-blue-700 via-blue-600 to-indigo-800 text-white overflow-hidden">
    <!-- Background Decorations -->
    <div class="absolute inset-0 opacity-20">
        <div class="absolute top-0 left-0 w-96 h-96 bg-white rounded-full blur-3xl -translate-x-1/2 -translate-y-1/2"></div>
        <div class="absolute bottom-0 right-0 w-[500px] h-[500px] bg-yellow-300 rounded-full blur-3xl translate-x-1/4 translate-y-1/4"></div>
        <div class="absolute top-1/2 left-1/2 w-64 h-64 bg-purple-400 rounded-full blur-3xl"></div>
    </div>

    <div class="max-w-7xl mx-auto px-4 py-20 md:py-36 relative z-10">
        <div class="grid md:grid-cols-2 gap-12 items-center">
            <div class="animate-fade-in text-center md:text-right">
                <span class="inline-block bg-white/20 text-white px-4 py-1.5 rounded-full text-sm mb-6 backdrop-blur-sm">
                    🚀 منصة تعليمية متكاملة
                </span>
                <h1 class="text-4xl md:text-6xl font-extrabold mb-6 leading-tight">
                    غير مستقبلك مع
                    <span class="text-yellow-300 relative">
                        MasrAcademyTech
                        <span class="absolute bottom-1 left-0 w-full h-2 bg-yellow-400/30 rounded-full"></span>
                    </span>
                </h1>
                <p class="text-lg text-blue-100 mb-8 leading-relaxed md:ml-10">
                    تعلم البرمجة، التصميم، والتسويق الإلكتروني مع أفضل المدربين. ابدأ رحلتك التعليمية اليوم وطور مهاراتك للمستقبل.
                </p>
                <div class="flex flex-col sm:flex-row gap-4 justify-center md:justify-start">
                    <a asp-controller="Home" asp-action="Courses"
                       class="group bg-white text-blue-700 px-8 py-4 rounded-2xl font-bold text-lg hover:bg-gray-100 transition-all shadow-xl hover:shadow-2xl transform hover:-translate-y-1 inline-flex items-center justify-center gap-2">
                        <i class="fas fa-play group-hover:animate-pulse"></i> تصفح الكورسات
                    </a>
                    <a href="#features"
                       class="border-2 border-white/50 text-white px-8 py-4 rounded-2xl font-bold text-lg hover:bg-white/10 hover:border-white transition-all inline-flex items-center justify-center gap-2 backdrop-blur-sm">
                        <i class="fas fa-chevron-down"></i> المزيد
                    </a>
                </div>
            </div>
            <div class="hidden md:flex justify-center animate-slide-in">
                <div class="relative">
                    <div class="absolute inset-0 bg-gradient-to-r from-blue-400 to-purple-400 rounded-3xl blur-2xl opacity-40 animate-pulse-custom" style="width: 110%; height: 110%; top: -5%; left: -5%;"></div>
                    <img src="/images/logo.jpg" alt="MasrAcademyTech" class="relative w-60 h-60 md:w-72 md:h-72 object-cover rounded-3xl border-4 border-white/30 shadow-2xl" />
                </div>
            </div>
        </div>
    </div>

    <!-- Wave -->
    <div class="absolute bottom-0 left-0 right-0">
        <svg viewBox="0 0 1440 100" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M0 100L1440 0V100H0Z" fill="#f9fafb" />
        </svg>
    </div>
</section>

<!-- Features -->
<section id="features" class="py-20 bg-gray-50 relative">
    <div class="max-w-7xl mx-auto px-4">
        <div class="text-center mb-16">
            <h2 class="text-4xl font-extrabold text-gray-800 mb-4">لماذا <span class="gradient-text">MasrAcademyTech</span>؟</h2>
            <p class="text-gray-500 text-lg">كل ما تحتاجه لتطوير مهاراتك في مكان واحد</p>
        </div>
        <div class="grid md:grid-cols-3 gap-8">
            <div class="group bg-white rounded-2xl p-8 text-center shadow-sm hover:shadow-xl transition-all duration-500 hover-lift animate-fade-in">
                <div class="w-20 h-20 bg-gradient-to-br from-blue-100 to-blue-200 rounded-2xl flex items-center justify-center mx-auto mb-6 group-hover:scale-110 transition-transform shadow-lg shadow-blue-100">
                    <i class="fas fa-play-circle text-blue-600 text-3xl"></i>
                </div>
                <h3 class="text-xl font-bold text-gray-800 mb-3">كورسات مرئية</h3>
                <p class="text-gray-500 leading-relaxed">تعلم من خلال فيديوهات عالية الجودة مع شرح تفصيلي لكل درس</p>
            </div>
            <div class="group bg-white rounded-2xl p-8 text-center shadow-sm hover:shadow-xl transition-all duration-500 hover-lift animate-fade-in" style="animation-delay: 0.2s">
                <div class="w-20 h-20 bg-gradient-to-br from-green-100 to-green-200 rounded-2xl flex items-center justify-center mx-auto mb-6 group-hover:scale-110 transition-transform shadow-lg shadow-green-100">
                    <i class="fas fa-headset text-green-600 text-3xl"></i>
                </div>
                <h3 class="text-xl font-bold text-gray-800 mb-3">دعم فني مستمر</h3>
                <p class="text-gray-500 leading-relaxed">فريق دعم جاهز للإجابة على أسئلتك وتقديم المساعدة</p>
            </div>
            <div class="group bg-white rounded-2xl p-8 text-center shadow-sm hover:shadow-xl transition-all duration-500 hover-lift animate-fade-in" style="animation-delay: 0.4s">
                <div class="w-20 h-20 bg-gradient-to-br from-purple-100 to-purple-200 rounded-2xl flex items-center justify-center mx-auto mb-6 group-hover:scale-110 transition-transform shadow-lg shadow-purple-100">
                    <i class="fas fa-certificate text-purple-600 text-3xl"></i>
                </div>
                <h3 class="text-xl font-bold text-gray-800 mb-3">شهادة إتمام</h3>
                <p class="text-gray-500 leading-relaxed">احصل على شهادة معتمدة بعد إتمام كل كورس بنجاح</p>
            </div>
        </div>
    </div>
</section>

<!-- Stats -->
<section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
            <div class="animate-fade-in">
                <p class="text-4xl font-extrabold gradient-text">50+</p>
                <p class="text-gray-500 mt-2">كورس تعليمي</p>
            </div>
            <div class="animate-fade-in" style="animation-delay: 0.1s">
                <p class="text-4xl font-extrabold gradient-text">5000+</p>
                <p class="text-gray-500 mt-2">طالب مسجل</p>
            </div>
            <div class="animate-fade-in" style="animation-delay: 0.2s">
                <p class="text-4xl font-extrabold gradient-text">24/7</p>
                <p class="text-gray-500 mt-2">دعم فني</p>
            </div>
            <div class="animate-fade-in" style="animation-delay: 0.3s">
                <p class="text-4xl font-extrabold gradient-text">100%</p>
                <p class="text-gray-500 mt-2">رضا العملاء</p>
            </div>
        </div>
    </div>
</section>

<!-- CTA -->
<section class="py-20 bg-gradient-to-r from-blue-600 via-blue-700 to-indigo-800 text-white relative overflow-hidden">
    <div class="absolute inset-0 opacity-10">
        <div class="absolute top-0 right-0 w-96 h-96 bg-white rounded-full blur-3xl"></div>
        <div class="absolute bottom-0 left-0 w-64 h-64 bg-yellow-300 rounded-full blur-3xl"></div>
    </div>
    <div class="max-w-4xl mx-auto px-4 text-center relative z-10">
        <h2 class="text-4xl font-extrabold mb-4">جاهز تبدأ رحلتك التعليمية؟</h2>
        <p class="text-xl text-blue-100 mb-10">انضم إلى آلاف المتعلمين وابدأ في تطوير مهاراتك اليوم</p>
        <a asp-controller="Home" asp-action="Courses"
           class="inline-flex items-center gap-3 bg-white text-blue-700 px-12 py-5 rounded-2xl font-bold text-xl hover:bg-gray-100 transition-all shadow-2xl hover:shadow-3xl transform hover:-translate-y-1">
            <i class="fas fa-rocket"></i> ابدأ الآن مجاناً
        </a>
    </div>
</section>