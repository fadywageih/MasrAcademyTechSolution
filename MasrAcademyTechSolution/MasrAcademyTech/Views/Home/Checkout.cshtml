@model MasrAcademyTech.DAL.Models.Courses.Course
@{
    ViewData["Title"] = "تأكيد الشراء";
}

<div class="bg-gray-50 min-h-screen py-12">
    <div class="max-w-lg mx-auto px-4 animate-fade-in">
        <div class="bg-white rounded-2xl shadow-lg overflow-hidden">
            <!-- Header -->
            <div class="bg-gradient-to-r from-blue-600 to-indigo-700 p-6 text-white text-center">
                <i class="fas fa-shopping-cart text-4xl mb-3"></i>
                <h2 class="text-2xl font-bold">تأكيد الشراء</h2>
            </div>

            <!-- Content -->
            <div class="p-6">
                <!-- Course Info -->
                <div class="bg-gray-50 rounded-xl p-5 mb-6">
                    <h3 class="text-lg font-bold text-gray-800 mb-3">@Model.Title</h3>
                    <p class="text-gray-500 text-sm mb-4">@Model.Description</p>
                    <div class="flex justify-between items-center border-t pt-4">
                        <span class="text-gray-600">المبلغ</span>
                        <span class="text-2xl font-extrabold text-blue-600">@Model.Price.ToString("C")</span>
                    </div>
                    <div class="flex items-center gap-2 mt-3 text-gray-400 text-sm">
                        <i class="fas fa-film"></i>
                        <span>@(Model.Lessons?.Count ?? 0) حلقات</span>
                    </div>
                </div>

                <!-- Payment Method -->
                <form asp-action="Pay" asp-controller="Home" method="post" class="space-y-4">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="courseId" value="@Model.Id" />

                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">طريقة الدفع</label>
                        <select name="paymentMethod" class="w-full border border-gray-300 rounded-xl p-3.5 focus:ring-2 focus:ring-blue-500 outline-none transition">
                            <option value="card">💳 بطاقة ائتمان (فيزا / ماستركارد)</option>
                            <option value="wallet">📱 فودافون كاش / محفظة إلكترونية</option>
                        </select>
                    </div>

                    <button type="submit"
                            class="w-full bg-gradient-to-r from-blue-600 to-blue-700 text-white py-4 rounded-xl font-bold text-lg hover:from-blue-700 hover:to-blue-800 transition-all shadow-xl hover:shadow-2xl transform hover:-translate-y-0.5">
                        <i class="fas fa-credit-card ml-2"></i> ادفع الآن
                    </button>
                </form>

                <a asp-action="Details" asp-route-id="@Model.Id"
                   class="block text-center text-gray-400 hover:text-gray-600 mt-4 transition">
                    <i class="fas fa-arrow-right ml-1"></i> رجوع
                </a>
            </div>
        </div>
    </div>
</div>