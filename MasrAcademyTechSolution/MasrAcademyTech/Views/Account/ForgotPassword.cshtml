@model MasrAcademyTech.Models.Account.ForgotPasswordViewModel
@{
    ViewData["Title"] = "نسيت كلمة المرور";
}

<div class="bg-gray-50 min-h-screen flex items-center justify-center px-4 py-12">
    <div class="bg-white rounded-2xl shadow-xl p-8 w-full max-w-md animate-fade-in text-center">
        <div class="w-20 h-20 bg-yellow-100 rounded-full flex items-center justify-center mx-auto mb-6">
            <i class="fas fa-key text-yellow-600 text-3xl"></i>
        </div>
        <h2 class="text-2xl font-bold text-gray-800 mb-2">نسيت كلمة المرور؟</h2>
        <p class="text-gray-500 mb-6">أدخل بريدك الإلكتروني وسنرسل لك رابط إعادة التعيين</p>

        <form asp-action="ForgotPassword" method="post" class="space-y-4">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-red-500 text-sm bg-red-50 p-3 rounded-xl"></div>

            <div class="relative">
                <i class="fas fa-envelope absolute right-3 top-1/2 -translate-y-1/2 text-gray-400"></i>
                <input asp-for="Email" class="w-full pr-10 pl-4 py-3.5 border border-gray-300 rounded-xl focus:ring-2 focus:ring-blue-500 outline-none transition" placeholder="example@email.com" />
            </div>
            <span asp-validation-for="Email" class="text-red-500 text-xs"></span>

            <button type="submit" class="w-full bg-gradient-to-r from-blue-600 to-blue-700 text-white py-3.5 rounded-xl font-bold text-lg hover:from-blue-700 hover:to-blue-800 transition-all shadow-lg">
                إرسال الرابط
            </button>
        </form>

        <a asp-action="Login" class="block text-gray-400 hover:text-gray-600 mt-6 transition text-sm">العودة لتسجيل الدخول</a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}