@model MasrAcademyTech.Models.Account.ResetPasswordViewModel
@{
    ViewData["Title"] = "إعادة تعيين كلمة المرور";
}

<div class="bg-gray-50 min-h-screen flex items-center justify-center px-4 py-12">
    <div class="bg-white rounded-2xl shadow-xl p-8 w-full max-w-md animate-fade-in">
        <div class="text-center mb-8">
            <div class="w-20 h-20 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-4">
                <i class="fas fa-lock text-blue-600 text-3xl"></i>
            </div>
            <h2 class="text-2xl font-bold text-gray-800">إعادة تعيين كلمة المرور</h2>
        </div>

        <form asp-action="ResetPassword" method="post" class="space-y-4">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Email" />
            <input type="hidden" asp-for="Token" />
            <div asp-validation-summary="ModelOnly" class="text-red-500 text-sm bg-red-50 p-3 rounded-xl"></div>

            <div class="relative">
                <i class="fas fa-lock absolute right-3 top-1/2 -translate-y-1/2 text-gray-400"></i>
                <input asp-for="Password" class="w-full pr-10 pl-4 py-3.5 border border-gray-300 rounded-xl focus:ring-2 focus:ring-blue-500 outline-none transition" placeholder="كلمة المرور الجديدة" />
            </div>
            <span asp-validation-for="Password" class="text-red-500 text-xs"></span>

            <div class="relative">
                <i class="fas fa-lock absolute right-3 top-1/2 -translate-y-1/2 text-gray-400"></i>
                <input asp-for="ConfirmPassword" class="w-full pr-10 pl-4 py-3.5 border border-gray-300 rounded-xl focus:ring-2 focus:ring-blue-500 outline-none transition" placeholder="تأكيد كلمة المرور" />
            </div>
            <span asp-validation-for="ConfirmPassword" class="text-red-500 text-xs"></span>

            <button type="submit" class="w-full bg-gradient-to-r from-blue-600 to-blue-700 text-white py-3.5 rounded-xl font-bold text-lg hover:from-blue-700 hover:to-blue-800 transition-all shadow-lg">
                حفظ كلمة المرور
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}