@model MasrAcademyTech.DAL.Models.Courses.Course
@{
    ViewData["Title"] = "إضافة كورس";
}

<div class="max-w-2xl mx-auto px-4 py-8 animate-fade-in">
    <h2 class="text-2xl font-bold text-gray-800 mb-6">
        <i class="fas fa-plus-circle text-blue-600 ml-2"></i>إضافة كورس جديد
    </h2>

    <form asp-action="Create" enctype="multipart/form-data" method="post" class="bg-white rounded-xl shadow p-6 space-y-5">
        @Html.AntiForgeryToken()

        <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">العنوان</label>
            <input asp-for="Title" class="w-full border border-gray-300 rounded-lg p-3 focus:ring-2 focus:ring-blue-500 outline-none" />
        </div>

        <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">الوصف القصير</label>
            <textarea asp-for="Description" class="w-full border border-gray-300 rounded-lg p-3 focus:ring-2 focus:ring-blue-500 outline-none" rows="2"></textarea>
        </div>

        <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">الوصف الكامل</label>
            <textarea asp-for="FullDescription" class="w-full border border-gray-300 rounded-lg p-3 focus:ring-2 focus:ring-blue-500 outline-none" rows="5"></textarea>
        </div>

        <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">السعر</label>
            <input asp-for="Price" class="w-full border border-gray-300 rounded-lg p-3 focus:ring-2 focus:ring-blue-500 outline-none" />
        </div>

        <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">الصورة</label>
            <input type="file" name="image" class="w-full border border-gray-300 rounded-lg p-3" />
        </div>

        <button type="submit" class="bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700 transition-all font-medium">
            <i class="fas fa-save ml-1"></i> حفظ
        </button>
        <a asp-action="Index" class="text-gray-500 hover:text-gray-700 mr-4">إلغاء</a>
    </form>
</div>