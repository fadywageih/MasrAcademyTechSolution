@model IEnumerable<MasrAcademyTech.DAL.Models.Courses.Lesson>
@{
    ViewData["Title"] = "الحلقات";
    var courseId = ViewBag.CourseId;
}

<div class="max-w-7xl mx-auto px-4 py-8 animate-fade-in">
    <div class="flex justify-between items-center mb-8">
        <h2 class="text-2xl font-bold text-gray-800">
            <i class="fas fa-list-ol text-green-600 ml-2"></i>الحلقات
        </h2>
        <a asp-action="AddLesson" asp-route-courseId="@courseId" class="bg-green-600 text-white px-5 py-2.5 rounded-lg hover:bg-green-700 transition-all text-sm font-medium">
            <i class="fas fa-plus ml-1"></i> إضافة حلقة
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-16 bg-white rounded-xl shadow">
            <i class="fas fa-film text-gray-300 text-5xl mb-4"></i>
            <p class="text-gray-500">لا يوجد حلقات بعد</p>
        </div>
    }
    else
    {
        <div class="bg-white rounded-xl shadow overflow-hidden">
            <table class="w-full">
                <thead class="bg-gray-50 border-b">
                    <tr>
                        <th class="p-4 text-right text-sm font-medium text-gray-600">#</th>
                        <th class="p-4 text-right text-sm font-medium text-gray-600">العنوان</th>
                        <th class="p-4 text-center text-sm font-medium text-gray-600">الفيديو</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var lesson in Model)
                    {
                        <tr class="border-b hover:bg-gray-50 transition">
                            <td class="p-4">@lesson.Order</td>
                            <td class="p-4 font-medium">@lesson.Title</td>
                            <td class="p-4 text-center">
                                @if (string.IsNullOrEmpty(lesson.VideoPath))
                                {
                                    <span class="text-gray-400">—</span>
                                }
                                else
                                {
                                    <span class="text-green-600"><i class="fas fa-check-circle"></i> مرفوع</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <a asp-action="Index" class="inline-block mt-6 text-blue-600 hover:text-blue-800">
        <i class="fas fa-arrow-right ml-1"></i> العودة للكورسات
    </a>
</div>